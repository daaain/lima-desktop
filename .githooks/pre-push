#!/bin/sh
# Refuse to push a v* tag whose commit doesn't carry that version in all three files: the Release
# workflow refuses it too, but only once the tag is public. `pnpm install` turns this on (it sets
# core.hooksPath to .githooks); `git push --no-verify` skips it.
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/tags/v*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # all zeros: deleting the tag
  sh "$root/tools/check-release-version.sh" "$local_sha^{commit}" "${remote_ref#refs/tags/v}" || status=1
done
exit $status
